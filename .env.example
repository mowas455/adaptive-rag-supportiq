# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector index: chroma (local disk) or supabase (pgvector + FTS)
VECTOR_BACKEND=chroma
# Project Settings → API. Use the service_role secret in the backend only.
# Never put the anon key here; the React app must not talk to this table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CHUNKS_TABLE=supportiq_chunks
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=supportiq
DOCS_DIR=./data/docs
PDF_DIR=./data/pdfs
ORDERS_DB=./data/orders.db

# Langfuse (self-hosted via docker-compose.langfuse.yml)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=lf_pk_supportiq_local
LANGFUSE_SECRET_KEY=lf_sk_supportiq_local
LANGFUSE_ENABLED=true

# Web search: duckduckgo (default, no key) or tavily
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# P1 embedding router
ROUTER_MIN_CONFIDENCE=0.55
ROUTER_MODEL_PATH=./ai/models/router.joblib
