# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=supportiq
DOCS_DIR=./data/docs
PDF_DIR=./data/pdfs
ORDERS_DB=./data/orders.db

# Langfuse (self-hosted via docker-compose.langfuse.yml)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=lf_pk_supportiq_local
LANGFUSE_SECRET_KEY=lf_sk_supportiq_local
LANGFUSE_ENABLED=true

# Web search: duckduckgo (default, no key) or tavily
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# P1 embedding router
ROUTER_MIN_CONFIDENCE=0.55
ROUTER_MODEL_PATH=./models/router.joblib
